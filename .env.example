# --- OpenAI (required) ---
OPENAI_API_KEY=sk-...
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_FALLBACK_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- Jira Cloud (required for live ticketing) ---
JIRA_BASE_URL=https://your-site.atlassian.net
JIRA_EMAIL=you@example.com
JIRA_API_TOKEN=your-atlassian-api-token
JIRA_PROJECT_KEY=SD
JIRA_ISSUE_TYPE=Task

# Set to "mock" to run fully offline with an in-memory ticket store
TICKETING_BACKEND=jira

# --- Retrieval tuning (optional) ---
RETRIEVAL_MODE=hybrid_rerank
RERANK_THRESHOLD=-5.5
CACHE_SIMILARITY=0.95

# --- Sign-in (web UI) ---
# Who may sign in. Fail closed: with both empty, nobody can. JSON lists.
ALLOWED_EMAIL_DOMAINS=[]
# ALLOWED_EMAILS=["you@gmail.com"]

# --- LangSmith (evaluation only; the app does not trace) ---
LANGSMITH_API_KEY=lsv2_...
LANGSMITH_PROJECT=smartdesk-eval
# EVAL_JUDGE_MODEL=gpt-4o
